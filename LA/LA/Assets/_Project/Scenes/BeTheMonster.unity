  m_text: '<color=#FFD633>1</color>  Blue lane is Survivor gear, red lane is Monster
    gear.

    <color=#FFD633>2</color>  Grab the nut above a cage and pull it down
    to buy.

    <color=#FFD633>3</color>  Hold a cable and look where you want to
    go.

    <color=#FFD633>4</color>  The best gear is on top of the Reactor.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 87e620be83eb9d04e8800ff4248bf302, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 4b4d98a2041df01449d196e597eed7f3, type: 2}
