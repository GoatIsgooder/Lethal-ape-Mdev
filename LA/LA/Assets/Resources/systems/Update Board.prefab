  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=200%><b>What's New</b></size>\n\n<b><size=150%>NEW LETHAL APE MARES 2026 PART 2</size></b>\nWe just added a new update with map changes and more, go check it out!\n\n<b><size=150%>NEW BANSHEE MONSTER</size></b>\nIf your inside the Outdoors, go find a grave with the name banshee and wait for 15-30 seconds and beware, it will find you and it will get you...\n\n<b><size=150%>NEW SEASON PASS ITEMS</size></b>\nNew season pass with two tiers!, Free - Allows you to get some free cosmetics, XP and GD, or Premium - Unlock new skins bundles and more!, All obtainable by purchasing it in spawn to the right, you can also complete the Quests on the same board to unlock more XP allowing you to level up!\n\n<b><size=150%>NEW MOD MENU</size></b>\nWe just added a new seasonal Mod menu that changes its look each season!, it has a new page thats SUPER op,  $29.99 in spawn and shop now!\n\n<b><size=150%>NEW PUMKIN LAUNCHER</size></b>\nKnock back players, and monsters with it, HAVE FUN!\n\n<b><size=150%>PROMO CODE</size></b>\n<color=#FFD700>AUGUST-2D62F9</color>\n<size=90%>Get <b>10% off</b> THE BRAND NEW BUNDLES</size>\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 87e620be83eb9d04e8800ff4248bf302, type: 2}
